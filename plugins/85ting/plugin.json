{
  "id": "85ting",
  "name": "85听书网",
  "version": "0.2.0",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "85ting.com",
      "www.85ting.com",
      "*.85ting.com",
      "imagev2.xmcdn.com",
      "aod.cos.tx.xmcdn.com"
    ],
    "process": [
      "ffmpeg",
      "ffmpeg.exe",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg",
      "/usr/bin/ffmpeg",
      "/snap/bin/ffmpeg",
      "C:\\ffmpeg\\bin\\ffmpeg.exe",
      "C:\\Program Files\\ffmpeg\\bin\\ffmpeg.exe"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "分类",
      "page": "categories",
      "icon": "playlist"
    },
    {
      "builtin": "liked",
      "title": "喜欢"
    }
  ],
  "settings": [
    {
      "key": "transcode",
      "label": "转码播放",
      "help": "85听书网的音频是 HE-AAC，应用自身解不了，需要本机装好 ffmpeg 并允许本插件运行它。填 0 关闭转码，直接播放原地址（多数内容会报 SBR 错误）。"
    },
    {
      "key": "ffmpegPath",
      "label": "ffmpeg 路径",
      "help": "留空则自动查找（先按 PATH，再试 /opt/homebrew/bin、/usr/local/bin 等常见位置）。找不到时填上完整路径，例如 /opt/homebrew/bin/ffmpeg。",
      "link": "https://ffmpeg.org/download.html"
    }
  ]
}
