{
  "id": "85ting",
  "name": "85听书网",
  "version": "0.2.2",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "85ting.com",
      "www.85ting.com",
      "*.85ting.com",
      "imagev2.xmcdn.com",
      "aod.cos.tx.xmcdn.com"
    ],
    "process": [
      "ffmpeg",
      "ffmpeg.exe",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg",
      "/usr/bin/ffmpeg",
      "/snap/bin/ffmpeg",
      "C:\\ffmpeg\\bin\\ffmpeg.exe",
      "C:\\Program Files\\ffmpeg\\bin\\ffmpeg.exe"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "分类",
      "page": "categories",
      "icon": "playlist"
    },
    {
      "builtin": "liked",
      "title": "喜欢"
    }
  ],
  "settings": [
    {
      "key": "transcode",
      "label": "转码播放",
      "help": "85听书网的音频是 HE-AAC，应用自身解不了，要用 ffmpeg 转成 AAC-LC。播放器（3.0.94 起）自带 ffmpeg，不用装系统版。填 0 关闭转码，直接播放原地址（多数内容会报 SBR 错误）。"
    },
    {
      "key": "ffmpegPath",
      "label": "ffmpeg 路径",
      "help": "留空就先用播放器自带的 ffmpeg；要指定别的版本时填完整路径（Windows 例 C:\\ffmpeg\\bin\\ffmpeg.exe）。",
      "link": "https://ffmpeg.org/download.html"
    }
  ]
}
