{
  "id": "tingfm",
  "name": "听FM电台",
  "version": "0.2.0",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "cn.tingfm.com",
      "tingfm.com",
      "*.tingfm.com",
      "search.qtfm.cn",
      "webapi.qtfm.cn",
      "m.qtfm.cn",
      "audio.qtfm.cn",
      "pic.qtfm.cn",
      "*.qtfm.cn"
    ]
  },
  "requestHeaders": [
    {
      "hosts": [
        "pic.qtfm.cn",
        "*.qtfm.cn"
      ],
      "kinds": [
        "image"
      ],
      "headers": {
        "referer": "https://m.qtfm.cn/",
        "user-agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15 Mobile"
      }
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "分类",
      "page": "categories",
      "icon": "radio"
    },
    {
      "title": "热门",
      "page": "popular",
      "icon": "chart"
    },
    {
      "builtin": "liked",
      "title": "喜欢"
    }
  ]
}
