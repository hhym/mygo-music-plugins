      "headers": { "referer": "https://www.dgcol.com/" }
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "每日热歌", "page": "daily:1", "icon": "chart" },
    { "title": "近期更新", "page": "newsong", "icon": "music" },
    { "builtin": "liked", "title": "我的喜欢" }
  ]
}
